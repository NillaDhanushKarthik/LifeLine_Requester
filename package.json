{
  "name": "lifeline-requester",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8081",
    "start:tunnel": "expo start --tunnel --port 8081",
    "start:go": "expo start --go --port 8081",
